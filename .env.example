# Copy to .env for local dev. Never commit real values.
# Production Workers values are set with:
#   wrangler secret put EMDASH_ENCRYPTION_KEY
#   wrangler secret put XOAEY_CONTACT_TOKEN

# Generated by `npm create emdash`. Encrypts plugin settings declared as secrets.
EMDASH_ENCRYPTION_KEY=

# Scoped API token (content write on the `inquiries` collection) used by the
# server-side /api/contact route. Create it in the admin under Users > API
# tokens after the setup wizard, then store it as a Worker secret.
XOAEY_CONTACT_TOKEN=
