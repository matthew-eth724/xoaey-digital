---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="xd-header">
			<div class="xd-container xd-header-inner">
				<a href="/" class="xd-brand" aria-label={`${siteTitle} home`}>
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								style="height:40px;width:auto;display:block;"
							/>
						) : (
							<>
								Xoaey <span>Digital</span>
							</>
						)
					}
				</a>
				<nav class="xd-nav" aria-label="Primary">
					{
						menu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={
									item.target === "_blank" ? "noopener noreferrer" : undefined
								}
							>
								{item.label}
							</a>
						))
					}
					<a href="/contact" class="xd-btn">Get a quote</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="xd-footer">
			<div class="xd-container">
				<div class="xd-footer-grid">
					<div>
						<h3>
							Xoaey <span style="color: var(--xd-accent)">Digital</span>
						</h3>
						<p>{siteTagline}</p>
					</div>
					<div>
						<h3>Services</h3>
						<ul>
							<li>
								<a href="/services/business-automations">
									Business automations
								</a>
							</li>
							<li>
								<a href="/services/website-design">Website design</a>
							</li>
						</ul>
					</div>
					<div>
						<h3>Company</h3>
						<ul>
							<li>
								<a href="/about">About</a>
							</li>
							<li>
								<a href="/contact">Contact</a>
							</li>
							<li>
								<a href="/">Home</a>
							</li>
						</ul>
					</div>
					<div>
						<h3>Get started</h3>
						<p>Tell us where your week disappears.</p>
						<a href="/contact" class="xd-btn">Start a project</a>
					</div>
				</div>
				<div class="xd-footer-bottom">
					<span>
						© {year} {siteTitle}. All rights reserved.
					</span>
					<span>Built with Astro &amp; EmDash.</span>
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
