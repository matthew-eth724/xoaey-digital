{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "xoaeydigital",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "xoaeydigital",
			"database_id": "14d574ab-9740-41af-8269-574b714942b9",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "xoaeydigital-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "55735701173f4b5fb479fac5c5564f0f",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}